# Telegram
TELEGRAM_BOT_TOKEN=
# @userinfobot 등으로 확인한 본인의 텔레그램 user id (숫자)
ALLOWED_TELEGRAM_USER_ID=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Coupang browser adapter (검색·상세조회 전용 — 로그인/결제 자동화는 하지 않는다)
# 평상시는 true(headless). 파싱이 잘 안 될 때 false로 두면 실제 화면을 보며 디버깅할 수 있다.
COUPANG_HEADLESS=true
