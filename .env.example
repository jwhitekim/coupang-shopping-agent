# Telegram
TELEGRAM_BOT_TOKEN=
# @userinfobot 등으로 확인한 본인의 텔레그램 user id (숫자)
ALLOWED_TELEGRAM_USER_ID=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Coupang browser adapter
COUPANG_PROFILE_DIR=./data/coupang-profile
# 평상시는 true(headless). 최초 로그인은 scripts/setup-login.ts가 headed로 별도 실행.
COUPANG_HEADLESS=true

# 3단계: 안전한 결제 (docs/data-model.md, docs/components.md 4.4장). 비우면 아래 기본값을 쓴다.
DB_PATH=./data/app.db
# 5단계: 결제 실패 시 원인 파악용 스크린샷 저장 위치 (Git에는 올리지 않음).
SCREENSHOT_DIR=./data/screenshots
POLICY_MAX_PRICE_PER_ITEM=50000
POLICY_MAX_PRICE_PER_ORDER=100000
POLICY_MAX_DAILY_SPEND=200000
POLICY_MAX_QUANTITY=3
POLICY_MAX_PRICE_INCREASE=500
POLICY_ALLOW_SUBSCRIPTIONS=false
POLICY_CONFIRMATION_TTL_SECONDS=300
